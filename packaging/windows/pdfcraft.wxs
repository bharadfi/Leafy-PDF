<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Leafy PDF" Manufacturer="Leafy PDF" Version="$(var.Version)" UpgradeCode="C07D4AFC-CCBD-573E-A02B-580EAB372348" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Leafy PDF PDF workbench" Manufacturer="Leafy PDF" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Leafy PDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="LeafyIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LeafyIcon.ico" />
    <!-- Desktop shortcut (#143): on by default for a first install, a checkbox in the full-UI
         welcome dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended
         installs. Secure, so the choice made in the (unelevated) UI reaches the elevated install.
         An update keeps the shortcut only if it is still on the desktop (#1058): the launcher
         updates with /passive and no properties, so deleting the shortcut is the only way its
         users can say no. A value given on the command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <!-- AppSearch runs before the full-UI scope page can choose Everyone, so [DesktopFolder] still
         names the user's desktop then. Search both desktops and keep the one for the chosen scope. -->
    <Property Id="EXISTINGDESKTOPSHORTCUT_USER">
      <DirectorySearch Id="DesktopSearchUser" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="Leafy PDF.lnk" />
      </DirectorySearch>
    </Property>
    <Property Id="EXISTINGDESKTOPSHORTCUT_MACHINE">
      <DirectorySearch Id="DesktopSearchMachine" Path="[%PUBLIC]\Desktop" Depth="0">
        <FileSearch Name="Leafy PDF.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CraftExistingMachineShortcut" Value="[EXISTINGDESKTOPSHORTCUT_MACHINE]" After="CraftLoadOption2U" Sequence="first" Condition="ALLUSERS = 1 AND EXISTINGDESKTOPSHORTCUT_MACHINE" />
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CraftExistingUserShortcut" Value="[EXISTINGDESKTOPSHORTCUT_USER]" After="CraftExistingMachineShortcut" Sequence="first" Condition="ALLUSERS &lt;&gt; 1 AND EXISTINGDESKTOPSHORTCUT_USER" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="CraftExistingUserShortcut" Sequence="first" Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <!-- The File Explorer menus: "Edit with Leafy PDF" for PDF files (#682) and "Create PDF with
         Leafy PDF…" for images (#190). Each is on by default for a first install and has a property
         to leave it out of unattended installs: INSTALLPDFCONTEXTMENU=0 (also a welcome-dialog
         checkbox) and INSTALLIMAGECONTEXTMENU=0. Secure, like the desktop shortcut's.
         An update keeps the installed version's choice (#305) by looking for the menu's registry
         key, the way the desktop shortcut looks for its file: AppSearch runs before the old version
         is removed. Releases from before a menu existed (the PDF one came in 0.7.1, the image one in
         0.4.0) never had the key, so updating from one of them counts as a first install; the
         OnlyDetect rows below tell them apart. A value given on the command line wins. -->
    <Upgrade Id="C07D4AFC-CCBD-573E-A02B-580EAB372348">
      <UpgradeVersion Minimum="0.7.1" IncludeMinimum="yes" OnlyDetect="yes" Property="PDFCONTEXTMENURELEASE" />
      <UpgradeVersion Minimum="0.4.0" IncludeMinimum="yes" OnlyDetect="yes" Property="IMAGECONTEXTMENURELEASE" />
    </Upgrade>
    <Property Id="INSTALLPDFCONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGPDFCONTEXTMENU" Secure="yes">
      </Property>
    <SetProperty Id="INSTALLPDFCONTEXTMENU" Value="1" After="CraftLoadOption2U" Sequence="first" Condition="NOT INSTALLPDFCONTEXTMENU AND (NOT PDFCONTEXTMENURELEASE OR EXISTINGPDFCONTEXTMENU)" />
    <Property Id="INSTALLIMAGECONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGIMAGECONTEXTMENU" Secure="yes">
      </Property>
    <SetProperty Id="INSTALLIMAGECONTEXTMENU" Value="1" After="CraftLoadOption2U" Sequence="first" Condition="NOT INSTALLIMAGECONTEXTMENU AND (NOT IMAGECONTEXTMENURELEASE OR EXISTINGIMAGECONTEXTMENU)" />
    <UIRef Id="LeafyInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Leafy PDF">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Leafy PDF" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="LeafyFiles" />
      <ComponentGroupRef Id="LeafyModels" />
    </Feature>
  <Property Id="CRAFT_OPTION_1_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_MSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LeafyPdf.Edit" Type="raw" />
    </Property><SetProperty Id="EXISTINGPDFCONTEXTMENU" Action="CraftLoadOption1M" Value="[CRAFT_OPTION_1_M]" After="LaunchConditions" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_1_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_USearch" Root="HKCU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LeafyPdf.Edit" Type="raw" />
    </Property><SetProperty Id="EXISTINGPDFCONTEXTMENU" Action="CraftLoadOption1U" Value="[CRAFT_OPTION_1_U]" After="CraftLoadOption1M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /><Property Id="CRAFT_OPTION_2_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_2_MSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\LeafyPdf.CreatePdf" Type="raw" />
    </Property><SetProperty Id="EXISTINGIMAGECONTEXTMENU" Action="CraftLoadOption2M" Value="[CRAFT_OPTION_2_M]" After="CraftLoadOption1U" Sequence="both" Condition="ALLUSERS = 1" /><Property Id="CRAFT_OPTION_2_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_2_USearch" Root="HKCU" Key="Software\Classes\SystemFileAssociations\.png\shell\LeafyPdf.CreatePdf" Type="raw" />
    </Property><SetProperty Id="EXISTINGIMAGECONTEXTMENU" Action="CraftLoadOption2U" Value="[CRAFT_OPTION_2_U]" After="CraftLoadOption2M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" /></Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="LeafyFiles" Directory="INSTALLFOLDER">
      <Component Id="LeafyApp" Guid="7FF7D45A-DD1E-5064-AB69-A30F4C90BBBC">
        <File Id="LeafyExe" Source="$(var.BinDir)\leafypdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\leafypdf.exe" Value="[#LeafyExe]" Type="string" />

        <!-- PDF files (#107): Leafy PDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             Leafy PDF entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\LeafyPdf.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app's lion; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\LeafyPdf.Document\DefaultIcon" Value="&quot;[#LeafyExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LeafyPdf.Document\shell\open\command" Value="&quot;[#LeafyExe]&quot; &quot;%1&quot;" Type="string" />
        <!-- No overlay on thumbnails and in the preview pane: without TypeOverlay, Windows paints
             the default program's icon (the lion) over the lower-right corner of every PDF
             thumbnail, covering part of the page. An empty string means none ("Thumbnail
             Handlers", Microsoft Learn). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\LeafyPdf.Document" Name="TypeOverlay" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids" Name="LeafyPdf.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\leafypdf.exe" Name="FriendlyAppName" Value="Leafy PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\leafypdf.exe\DefaultIcon" Value="&quot;[#LeafyExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\leafypdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\leafypdf.exe\shell\open\command" Value="&quot;[#LeafyExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LeafyPdf\Capabilities" Name="ApplicationName" Value="Leafy PDF" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LeafyPdf\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LeafyPdf\Capabilities" Name="ApplicationIcon" Value="[#LeafyExe],0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LeafyPdf\Capabilities\FileAssociations" Name=".pdf" Value="LeafyPdf.Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="Leafy PDF" Value="Software\LeafyPdf\Capabilities" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\LeafyPdf" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Explorer's thumbnail handler (crates/thumbs): a snapshot of the first page for PDF files, the Leafy PDF
           tile for password-protected ones. It is registered on Leafy PDF's own file type and application key only, so it applies
           where Leafy PDF is the default app for .pdf and never replaces another app's handler. The library
           runs leafypdf.exe with its thumbnail option from this folder; uninstalling removes both together. -->
      <Component Id="LeafyThumbnailHandler" Guid="B00FA49E-5E1C-40DB-A12D-6B116BA66D06">
        <File Id="LeafyThumbsDll" Source="$(var.BinDir)\leafypdf_thumbs.dll" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\CLSID\{93E5ACCA-84E1-4B0B-A11A-2AACD2262036}" Value="Leafy PDF thumbnail handler" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\CLSID\{93E5ACCA-84E1-4B0B-A11A-2AACD2262036}\InprocServer32" Value="[#LeafyThumbsDll]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\CLSID\{93E5ACCA-84E1-4B0B-A11A-2AACD2262036}\InprocServer32" Name="ThreadingModel" Value="Apartment" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LeafyPdf.Document\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{93E5ACCA-84E1-4B0B-A11A-2AACD2262036}" Type="string" />
        <!-- Windows reads the handlers of the app the user picked from "Open with" (the Applications key) when it
             has no ProgID of its own to go by, so the same handler is named there. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\leafypdf.exe\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Value="{93E5ACCA-84E1-4B0B-A11A-2AACD2262036}" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to leafypdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="LeafyStartMenuShortcut" Directory="ProgramMenuFolder" Guid="EBF5D534-8296-5C8E-B4BB-1D9CFB6F0143">
        <Shortcut Id="StartMenuShortcut" Name="Leafy PDF" Description="Leafy PDF PDF workbench" Target="[#LeafyExe]" WorkingDirectory="INSTALLFOLDER" Icon="LeafyIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\LeafyPdf\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="LeafyDesktopShortcut" Directory="DesktopFolder" Guid="FD66D332-E60C-5B1B-BD2C-119924A5DB95" Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Leafy PDF" Description="Leafy PDF PDF workbench" Target="[#LeafyExe]" WorkingDirectory="INSTALLFOLDER" Icon="LeafyIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\LeafyPdf\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): "Edit with Leafy PDF" opens the file in Leafy PDF whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with an HKLM key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="LeafyPdfContextMenu" Guid="ECA61372-02C7-583E-8EE0-B04E5A699FFD" Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LeafyPdf.Edit" Value="Edit with Leafy PDF" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LeafyPdf.Edit" Name="Icon" Value="&quot;[#LeafyExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LeafyPdf.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\LeafyPdf.Edit\command" Value="&quot;[#LeafyExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Image context menu (#190): "Create PDF with Leafy PDF…" opens the DPI chooser, without
           changing image file defaults. Its own component with an HKLM key path, so
           INSTALLIMAGECONTEXTMENU=0 leaves it out and uninstall removes it. These rows were in
           LeafyApp up to 0.7.1; moving them is safe because MajorUpgrade removes the old version
           before installing (afterInstallValidate), so no old row is left behind. -->
      <Component Id="LeafyImageContextMenu" Guid="EA1C209A-D4DA-59E3-AEE4-009546EDB862" Condition="INSTALLIMAGECONTEXTMENU = 1">
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jp2\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.j2k\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\LeafyPdf.CreatePdf" Value="Create PDF with Leafy PDF…" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\LeafyPdf.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpx\shell\LeafyPdf.CreatePdf\command" Value="&quot;[#LeafyExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <!-- The project licences travel with the binaries. -->
      <Component Id="LeafyMitLicense">
        <File Id="LeafyMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="LeafyApacheLicense">
        <File Id="LeafyApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="LeafyNotice">
        <File Id="LeafyNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside leafypdf.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="LeafyModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
