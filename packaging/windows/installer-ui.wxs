<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="LeafyInstallerUI">
      <TextStyle Id="InstallerNormal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="InstallerTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
      <Property Id="DefaultUIFont" Value="InstallerNormal" />

      <Dialog Id="InstallWelcome" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Install [ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="40" Text="Setup will install [ProductName] for all users and add it to the Start menu. Click Install to continue." HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" />
        <Control Id="DescriptionUser" Type="Text" X="20" Y="55" Width="330" Height="40" Text="Setup will install [ProductName] only for your account and add it to the Start menu. Click Install to continue." HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" />
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="105" Width="330" Height="17" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
        <Control Id="PdfContextMenu" Type="CheckBox" X="20" Y="123" Width="330" Height="17" Property="INSTALLPDFCONTEXTMENU" CheckBoxValue="1" Text="Add &quot;&amp;Edit with Leafy PDF&quot; to the right-click menu of PDF files" />
        <Control Id="Install" Type="PushButton" X="195" Y="145" Width="75" Height="23" Default="yes" DefaultCondition="ALLUSERS = 1" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="InstallUser" Type="PushButton" DefaultCondition="ALLUSERS &lt;&gt; 1" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="195" Y="145" Width="75" Height="23" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="145" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Where to install: shown after the scope page, with the folder that page's choice implies
           already filled in. The path box edits INSTALLFOLDER through CRAFT_INSTALLDIR (the name of the
           directory property), exactly as Browse and SetTargetPath expect. -->
      <Property Id="CRAFT_INSTALLDIR" Value="INSTALLFOLDER" />
      <Dialog Id="CraftFolderDlg" Width="370" Height="220" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="30" Text="{\InstallerTitle}Where do you want to install [ProductName]?" />
        <Control Id="Info" Type="Text" X="20" Y="50" Width="330" Height="30" Text="Setup will install into the folder below. Type a path or click Browse to pick any drive and folder." />
        <Control Id="InstallPathLabel" Type="Text" X="20" Y="92" Width="330" Height="10" Text="Install &amp;location:" />
        <Control Id="InstallPath" Type="PathEdit" X="20" Y="104" Width="250" Height="18" Property="CRAFT_INSTALLDIR" Indirect="yes" />
        <Control Id="InstallBrowse" Type="PushButton" X="280" Y="103" Width="70" Height="20" Text="&amp;Browse...">
          <Publish Property="_BrowseProperty" Value="[CRAFT_INSTALLDIR]" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>
        <Control Id="Next" Type="PushButton" X="214" Y="182" Width="66" Height="20" Default="yes" Text="&amp;Next">
          <Publish Event="SetTargetPath" Value="[CRAFT_INSTALLDIR]" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="290" Y="182" Width="60" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- The folder browser: drives and folders, Up, New folder and a typed path. -->
      <Dialog Id="BrowseDlg" Width="370" Height="230" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="PathEdit" Type="PathEdit" X="20" Y="170" Width="330" Height="18" Property="_BrowseProperty" Indirect="yes" />
        <Control Id="OK" Type="PushButton" X="214" Y="196" Width="66" Height="20" Default="yes" Text="OK">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="196" Width="66" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="Reset" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="20" Y="54" Width="266" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes" />
        <Control Id="Up" Type="PushButton" X="292" Y="54" Width="28" Height="19" Text="&amp;Up">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="324" Y="54" Width="30" Height="19" Text="&amp;New">
          <Publish Event="DirectoryListNew" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="20" Y="82" Width="330" Height="70" Property="_BrowseProperty" Sunken="yes" Indirect="yes" />
        <Control Id="BrowseTitle" Type="Text" X="20" Y="12" Width="330" Height="20" Text="{\InstallerTitle}Choose install folder" TabSkip="yes" />
        <Control Id="ComboLabel" Type="Text" X="20" Y="42" Width="200" Height="10" Text="Look &amp;in (drive / folder):" TabSkip="yes" />
        <Control Id="PathLabel" Type="Text" X="20" Y="158" Width="330" Height="10" Text="&amp;Folder name:" TabSkip="yes" />
      </Dialog>

      <Dialog Id="InstallMaintenance" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Maintain [ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70" Text="[ProductName] is already installed. Choose Repair to restore missing files and shortcuts, or Remove to uninstall it." />
        <Control Id="Repair" Type="PushButton" X="110" Y="145" Width="75" Height="23" Default="yes" DefaultCondition="ALLUSERS = 1" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="&amp;Repair">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="amus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="RepairUser" Type="PushButton" DefaultCondition="ALLUSERS &lt;&gt; 1" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="110" Y="145" Width="75" Height="23" Text="&amp;Repair">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="amus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="195" Y="145" Width="75" Height="23" ElevationShield="yes" HideCondition="ALLUSERS &lt;&gt; 1" ShowCondition="ALLUSERS = 1" Text="R&amp;emove">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="RemoveUser" Type="PushButton" HideCondition="ALLUSERS = 1" ShowCondition="ALLUSERS &lt;&gt; 1" X="195" Y="145" Width="75" Height="23" Text="R&amp;emove">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="145" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="InstallProgress" Width="370" Height="180" Title="[ProductName] Setup" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setting up [ProductName]" />
        <!-- No ActionText table is authored: subscribing would blank this message (#305). -->
        <Control Id="Status" Type="Text" X="20" Y="60" Width="330" Height="40" Text="Please wait while setup completes." />
        <Control Id="Progress" Type="ProgressBar" X="20" Y="110" Width="330" Height="15" ProgressBlocks="yes">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="145" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="ConfirmCancel" />
        </Control>
      </Dialog>

      <Dialog Id="ConfirmCancel" Width="300" Height="110" Title="Cancel setup">
        <Control Id="Description" Type="Text" X="20" Y="20" Width="260" Height="35" Text="Cancel [ProductName] setup?" />
        <Control Id="Yes" Type="PushButton" X="130" Y="70" Width="70" Height="23" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="210" Y="70" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallComplete" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setup completed successfully" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70" Text="[ProductName] setup has completed successfully. Click Finish to close this window." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallFailed" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setup failed" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70" Text="[ProductName] setup could not be completed. Resolve the reported error and run setup again." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallCancelled" Width="370" Height="180" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" Text="{\InstallerTitle}Setup cancelled" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="70" Text="[ProductName] setup was cancelled. Run setup again when you are ready." />
        <Control Id="Finish" Type="PushButton" X="280" Y="145" Width="70" Height="23" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Shown by Windows Installer (Restart Manager) when an upgrade or repair must replace files
           that a running Leafy PDF holds open. OK closes those programs (MSIRMSHUTDOWN=2) and
           continues; Cancel ends setup. -->
      <Dialog Id="MsiRMFilesInUse" Width="370" Height="200" Title="[ProductName] Setup" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="25" Text="{\InstallerTitle}Files in use" />
        <Control Id="Description" Type="Text" X="20" Y="45" Width="330" Height="30" Text="These programs are using files that setup needs to update. Click OK to close them and continue, or Cancel to stop setup." />
        <Control Id="List" Type="ListBox" X="20" Y="80" Width="330" Height="55" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="OK" Type="PushButton" X="195" Y="165" Width="75" Height="23" Default="yes" Text="OK">
          <Publish Property="MSIRMSHUTDOWN" Value="2" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="165" Width="70" Height="23" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="CraftFolderDlg" Before="InstallWelcome" Condition="UILevel = 5 AND NOT Installed AND NOT REMOVE" />
        <Show Dialog="InstallWelcome" Before="InstallMaintenance" Condition="UILevel = 5 AND NOT Installed" />
        <Show Dialog="InstallMaintenance" Before="InstallProgress" Condition="UILevel = 5 AND Installed AND NOT REMOVE AND NOT REINSTALL" />
        <Show Dialog="InstallProgress" Before="ExecuteAction" Condition="UILevel = 5" />
        <Show Dialog="InstallComplete" OnExit="success" Condition="UILevel = 5" />
        <Show Dialog="InstallFailed" OnExit="error" Condition="UILevel = 5" />
        <Show Dialog="InstallCancelled" OnExit="cancel" Condition="UILevel = 5" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
